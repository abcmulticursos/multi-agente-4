# Contraseña del dashboard. Cualquiera con la URL del deploy verá una
# pantalla de login que pide este valor. Sin esto, el dashboard queda
# bloqueado completo (devuelve 503). Si la cambiás, todas las sesiones
# existentes quedan invalidadas y hay que volver a loguearse.
DASHBOARD_PASSWORD=elegi-una-contrasena-larga-y-aleatoria

# GitHub publish del editor. GITHUB_REPO es obligatorio para que los cambios
# del dashboard se publiquen en la repo correcta y sobrevivan redeploys.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=abcmulticursos/guerreras-kpop
EXPECTED_GITHUB_REPO=abcmulticursos/guerreras-kpop
GITHUB_BRANCH=main

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=1234567890
META_WABA_ID=1234567890
META_APP_SECRET=abcdef...
META_VERIFY_TOKEN=algo-aleatorio-que-vos-elegis
META_GRAPH_VERSION=v21.0

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# Modelo SOLO para leer imágenes/comprobantes (visión). Vacío = usa OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Groq (transcripción de audios con Whisper)
GROQ_API_KEY=gsk_...
# Opcional: por defecto whisper-large-v3-turbo (rápido + preciso)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Opcional: idioma esperado (mejora la calidad). Por defecto "es".
# GROQ_WHISPER_LANG=es

# Gmail SMTP (para enviar el email del curso al cliente tras la compra)
# Generar GMAIL_APP_PASSWORD en https://myaccount.google.com/apppasswords
# (requiere verificación en 2 pasos activada en la cuenta)
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Número de WhatsApp del administrador al que se envían notificaciones:
# compras aprobadas, errores graves, quejas, etc. Formato internacional
# sin "+", solo dígitos. Ejemplo Perú: 51935286681
# IMPORTANTE: el admin debe mandar un mensaje cualquiera al bot al menos
# 1 vez cada 24h para mantener abierta la ventana de mensajería de Meta
# (sino las notificaciones fallan hasta que vuelva a escribirle).
ADMIN_NOTIFY_PHONE=51935286681

# NocoDB — CRM de leads. Cada conversación crea/actualiza una fila en la
# tabla "Leads" con: fecha, número, nombre, canal, resumen, label
# (warm/hot/pago/reclamo) y estado de los 4 seguimientos. La integración
# es fire-and-forget — si NocoDB no está configurado, el bot sigue
# funcionando normal sin sincronizar.
#
# Crear el API token en NocoDB → Avatar → Account Settings → Tokens.
# El TABLE_ID se ve en la URL del navegador al abrir la tabla
# (la parte después del último "/").
NOCODB_BASE_URL=https://nocodb.tudominio.com
NOCODB_TOKEN=xxxxxxxxxxxxxxxxxxxx
NOCODB_TABLE_ID=xxxxxxxxxxxxxxx

# Secret compartido entre NocoDB y el bot para autenticar el webhook que
# notifica eliminaciones. Configurar en NocoDB → tabla → Webhooks →
# "After Delete" → URL: https://<tu-dominio>/api/nocodb-webhook?secret=<este_valor>
# Generá un string aleatorio largo (ej. con `openssl rand -hex 32`).
NOCODB_WEBHOOK_SECRET=cambia-este-valor-por-uno-aleatorio-largo

# Meta Conversions API (reportar Purchase + Contact events a Meta para
# optimización de ads). Generar Pixel y Access Token en:
# https://business.facebook.com/events_manager
META_PIXEL_ID=1234567890123456
META_CAPI_ACCESS_TOKEN=EAA...
# ID de la página de Facebook vinculada al WABA. Meta lo exige en eventos
# del canal WhatsApp (sino devuelve error 400 / subcode 2804069). Se
# consigue en tu Página de Facebook → Acerca de → ID de la página.
META_PAGE_ID=1234567890123456
# Opcional: código para probar eventos en el "Test Events" tab antes de
# que cuenten en métricas reales. Déjalo vacío para producción.
# META_CAPI_TEST_EVENT_CODE=TEST12345

# Salvaguarda contra "container dormido": un servicio de cron externo
# (cron-job.org, UptimeRobot, etc.) pega cada 1-5 min a /api/cron/tick
# con header `Authorization: Bearer ${CRON_SECRET}` para forzar el
# procesamiento de seguimientos vencidos aunque el setInterval interno
# haya quedado congelado por el hosting. Generá un string largo aleatorio
# (ej. con `openssl rand -hex 32`).
CRON_SECRET=cambia-este-valor-por-uno-aleatorio-largo
